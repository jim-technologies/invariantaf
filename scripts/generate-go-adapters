#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = ["protobuf==7.36.2"]
# ///
"""Generate explicit Go gRPC adapters from the embedded descriptor graph."""

import argparse
import json
import re
import subprocess
import tempfile
from pathlib import Path

from google.protobuf import descriptor_pb2

ROOT = Path(__file__).resolve().parents[1]

CODEC = """// Code generated by scripts/generate-go-adapters. DO NOT EDIT.
package main

import (
    "bytes"
    "context"
    "encoding/json"
    "errors"
    "fmt"
    "io"
    "math"
    "net"
    "os"
    "strconv"
    "time"

    invariant "github.com/jim-technologies/invariantprotocol/go"
    "google.golang.org/grpc"
    "google.golang.org/protobuf/encoding/protojson"
    "google.golang.org/protobuf/proto"
    "google.golang.org/protobuf/reflect/protoreflect"
    "google.golang.org/protobuf/types/known/structpb"
)

func requestStruct(request proto.Message) (*structpb.Struct, error) {
    options := protojson.MarshalOptions{
        UseProtoNames: true, EmitDefaultValues: true,
    }
    body, err := options.Marshal(request)
    if err != nil { return nil, err }
    result := new(structpb.Struct)
    if err := protojson.Unmarshal(body, result); err != nil { return nil, err }
    return result, nil
}

func decodeProviderJSON(body []byte, target any) error {
    decoder := json.NewDecoder(bytes.NewReader(body))
    decoder.UseNumber()
    if err := decoder.Decode(target); err != nil { return err }
    var trailing any
    if err := decoder.Decode(&trailing); err != io.EOF {
        return fmt.Errorf("provider response has trailing JSON")
    }
    return nil
}

func typedResponse(body []byte, target proto.Message) error {
    fields := target.ProtoReflect().Descriptor().Fields()
    if fields.Len() == 1 {
        field := fields.Get(0)
        var object map[string]json.RawMessage
        if err := json.Unmarshal(body, &object); err == nil {
            _, protoName := object[string(field.Name())]
            _, jsonName := object[field.JSONName()]
            if !protoName && !jsonName {
                if field.IsList() && len(object) == 1 && object["items"] != nil {
                    var err error
                    body, err = json.Marshal(map[string]json.RawMessage{
                        string(field.Name()): object["items"],
                    })
                    if err != nil { return err }
                } else if field.IsMap() ||
                    (field.Kind() == protoreflect.MessageKind && !field.IsList()) {
                    var err error
                    body, err = json.Marshal(map[string]json.RawMessage{
                        string(field.Name()): body,
                    })
                    if err != nil { return err }
                }
            }
        }
    }
    return protojson.Unmarshal(body, target)
}

type numericRequestError struct{}
func (numericRequestError) Error() string {
    return "invalid or inexact protobuf numeric conversion"
}
type numericProviderError struct{}
func (numericProviderError) Error() string { return "invalid provider numeric field" }

func providerInteger(value any) int64 {
    if value == nil { return 0 }
    switch number := value.(type) {
    case json.Number:
        result, err := number.Int64()
        if err != nil { panic(numericProviderError{}) }
        return result
    case int64: return number
    case int: return int64(number)
    case float64:
        if math.IsNaN(number) || math.IsInf(number, 0) ||
            math.Trunc(number) != number || math.Abs(number) > 9007199254740991 {
            panic(numericProviderError{})
        }
        return int64(number)
    default: panic(numericProviderError{})
    }
}

func providerInteger32(value any) int32 {
    result := providerInteger(value)
    if result < math.MinInt32 || result > math.MaxInt32 {
        panic(numericProviderError{})
    }
    return int32(result)
}

func providerNumber(value any) float64 {
    if value == nil { return 0 }
    switch number := value.(type) {
    case json.Number:
        result, err := number.Float64()
        if err != nil || math.IsNaN(result) || math.IsInf(result, 0) {
            panic(numericProviderError{})
        }
        return result
    case float64:
        if math.IsNaN(number) || math.IsInf(number, 0) {
            panic(numericProviderError{})
        }
        return number
    default: panic(numericProviderError{})
    }
}

func requestInteger(value *structpb.Value) int64 {
    if value == nil { return 0 }
    if text, ok := value.Kind.(*structpb.Value_StringValue); ok {
        number, err := strconv.ParseInt(text.StringValue, 10, 64)
        if err != nil { panic(numericRequestError{}) }
        return number
    }
    number, ok := value.Kind.(*structpb.Value_NumberValue)
    if !ok || math.IsNaN(number.NumberValue) ||
        math.IsInf(number.NumberValue, 0) ||
        math.Trunc(number.NumberValue) != number.NumberValue ||
        math.Abs(number.NumberValue) > 9007199254740991 {
        panic(numericRequestError{})
    }
    return int64(number.NumberValue)
}

func requestNumber(value *structpb.Value) float64 {
    if value == nil { return 0 }
    if text, ok := value.Kind.(*structpb.Value_StringValue); ok {
        number, err := strconv.ParseFloat(text.StringValue, 64)
        if err != nil || math.IsNaN(number) || math.IsInf(number, 0) ||
            (math.Trunc(number) == number && math.Abs(number) > 9007199254740991) {
            panic(numericRequestError{})
        }
        return number
    }
    number, ok := value.Kind.(*structpb.Value_NumberValue)
    if !ok || math.IsNaN(number.NumberValue) || math.IsInf(number.NumberValue, 0) {
        panic(numericRequestError{})
    }
    return number.NumberValue
}

func serveAdapter(ctx context.Context, server *invariant.Server, args []string) error {
    if len(args) == 0 { return server.ServeProjections(ctx, invariant.MCP()) }
    if args[0] == "--cli" {
        os.Args = append([]string{os.Args[0]}, args[1:]...)
        return server.ServeProjections(ctx, invariant.CLI())
    }
    port := 8080
    if args[0] == "--grpc" { port = 50051 }
    if len(args) > 1 {
        var err error
        port, err = strconv.Atoi(args[1])
        if err != nil || port < 0 || port > 65535 {
            return fmt.Errorf("invalid listener port")
        }
    }
    switch args[0] {
    case "--http": return server.ServeProjections(ctx, invariant.HTTP(port))
    case "--grpc":
        listener, err := net.Listen("tcp", fmt.Sprintf(":%d", port))
        if err != nil { return err }
        defer listener.Close()
        done := make(chan struct{})
        defer close(done)
        go func() {
            select {
            case <-done: return
            case <-ctx.Done():
            }
            drained := make(chan struct{})
            go func() { server.GracefulStop(); close(drained) }()
            timer := time.NewTimer(5 * time.Second)
            defer timer.Stop()
            select {
            case <-drained:
            case <-timer.C: server.Stop()
            }
        }()
        err = server.Serve(listener)
        if errors.Is(err, grpc.ErrServerStopped) { return nil }
        return err
    default: return fmt.Errorf("projection must be --cli, --http, or --grpc")
    }
}
"""


def formatted(source):
    result = subprocess.run(
        ["gofmt"], input=source.encode(), capture_output=True, check=True
    )
    return result.stdout


def bindings(module, check):
    if module.name == "temporal":
        return
    paths = sorted((module / "proto").rglob("*.proto"))
    with tempfile.TemporaryDirectory(prefix="go-adapter-bindings-") as temporary:
        temporary = Path(temporary)
        graph = temporary / "descriptor.binpb"
        subprocess.run(
            [
                "buf",
                "build",
                "--as-file-descriptor-set",
                str(module / "proto"),
                "-o",
                str(graph),
            ],
            check=True,
        )
        descriptor = descriptor_pb2.FileDescriptorSet.FromString(graph.read_bytes())
        owned = {str(path.relative_to(module / "proto")) for path in paths}
        options = [
            "paths=import",
            f"module=github.com/jim-technologies/invariantaf/{module.name}",
        ]
        for file in descriptor.file:
            if file.name in owned and not file.options.go_package:
                package = (
                    f"github.com/jim-technologies/invariantaf/{module.name}/"
                    f"proto/{Path(file.name).parent}"
                )
                options.append(
                    f"M{file.name}={package};{module.name.replace('_', '')}v1"
                )
        output = temporary / "output"
        output.mkdir()
        template = temporary / "buf.gen.json"
        template.write_text(
            json.dumps(
                {
                    "version": "v2",
                    "plugins": [
                        {"protoc_builtin": "go", "out": str(output), "opt": options},
                        {
                            "local": "protoc-gen-go-grpc",
                            "out": str(output),
                            "opt": [*options, "require_unimplemented_servers=false"],
                        },
                    ],
                }
            )
        )
        command = ["buf", "generate", str(graph), "--template", str(template)]
        for path in sorted(owned):
            command.extend(["--path", path])
        subprocess.run(command, cwd=module / "proto", check=True)
        artifacts = {module / "descriptor.binpb": graph.read_bytes()}
        artifacts.update(
            {
                module / path.relative_to(output): path.read_bytes()
                for path in output.rglob("*.go")
            }
        )
        existing = {
            path
            for path in module.rglob("*.pb.go")
            if not any(part.startswith(".") for part in path.relative_to(module).parts)
        }
        obsolete = existing - artifacts.keys()
        if obsolete:
            names = ", ".join(str(path.relative_to(ROOT)) for path in sorted(obsolete))
            raise SystemExit(f"obsolete Go binding requires explicit removal: {names}")
        for path, body in artifacts.items():
            if check:
                if not path.is_file() or path.read_bytes() != body:
                    raise SystemExit(
                        f"stale Go binding/descriptor: {path.relative_to(ROOT)}"
                    )
            else:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(body)


def generate(module):
    descriptor = descriptor_pb2.FileDescriptorSet.FromString(
        (module / "descriptor.binpb").read_bytes()
    )
    messages = {}
    owned_files = {
        str(path.relative_to(module / "proto"))
        for path in (module / "proto").rglob("*.proto")
    }

    def go_package(file):
        if file.options.go_package:
            return file.options.go_package.split(";", 1)[0]
        if file.name in owned_files:
            return (
                f"github.com/jim-technologies/invariantaf/{module.name}/"
                f"proto/{Path(file.name).parent}"
            )
        raise ValueError(f"imported message lacks a Go binding: {file.name}")

    def collect(file, prefix, definitions, parents=()):
        package = go_package(file)
        for message in definitions:
            name = prefix + "." + message.name
            messages[name] = (package, "_".join((*parents, message.name)))
            collect(file, name, message.nested_type, (*parents, message.name))

    for file in descriptor.file:
        collect(file, file.package, file.message_type)
    services = [
        (file, service)
        for file in descriptor.file
        for service in file.service
        if file.name in owned_files
    ]
    if not services:
        return {module / "rpc_codec.gen.go": formatted(CODEC)}
    imports = {"github.com/jim-technologies/invariantprotocol/go": "invariant"}

    def typename(fullname):
        package, name = messages[fullname.lstrip(".")]
        alias = (
            "pb"
            if package.startswith(
                f"github.com/jim-technologies/invariantaf/{module.name}/"
            )
            else package.rsplit("/", 1)[-1]
        )
        imports[package] = alias
        return alias + "." + name

    declarations = []
    registrations = []
    backends = {}
    implementation = (module / "service.go").read_text()
    signatures = re.findall(r"func \(\w+ \*(\w+)\) (\w+)\(([^\n]*)\)", implementation)
    for file, service in services:
        package = go_package(file)
        imports[package] = "pb"
        candidates = [item for item in signatures if item[1] == service.method[0].name]
        candidate = next(
            (item for item in candidates if item[0] == service.name), candidates[0]
        )
        backend_type = candidate[0]
        backend_arg = backends.setdefault(backend_type, "backend" + str(len(backends)))
        direct = "*structpb.Struct" not in candidate[2]
        imports.update(
            {
                "context": "",
                "google.golang.org/grpc/codes": "codes",
                "google.golang.org/grpc/status": "status",
            }
        )
        backend = service.name
        declarations.append(
            f"type typed{backend} struct {{ backend *{backend_type} }}\n"
        )
        registrations.append(
            f"pb.Register{service.name}Server("
            f"server, &typed{backend}{{backend: {backend_arg}}})"
        )
        for method in service.method:
            if method.client_streaming or method.server_streaming:
                raise ValueError(
                    "streaming method needs an explicit provider implementation: "
                    f"{method.name}"
                )
            request, response = (
                typename(method.input_type),
                typename(method.output_type),
            )
            body = f"""func (s *typed{backend}) {method.name}(
    ctx context.Context, request *{request},
) (result *{response}, err error) {{
    defer func() {{
        if recovered := recover(); recovered != nil {{
            if _, ok := recovered.(numericRequestError); ok {{
                result = nil
                err = status.Error(codes.InvalidArgument,
                    "invalid or inexact protobuf numeric conversion")
            }} else if _, ok := recovered.(numericProviderError); ok {{
                result = nil
                err = status.Error(codes.Internal, "invalid provider numeric field")
            }} else {{ panic(recovered) }}
        }}
    }}()
"""
            if direct:
                body += f"    return s.backend.{method.name}(ctx, request)\n}}\n"
                declarations.append(body)
                continue
            body += f"""    fields, err := requestStruct(request)
    if err != nil {{ return nil, err }}
    data, err := s.backend.{method.name}(ctx, fields)
    if err != nil {{ return nil, err }}
"""
            if method.output_type == ".google.protobuf.Struct":
                body += "    return data, nil\n}\n"
            else:
                body += f"""    result = new({response})
    if err := typedResponse(data, result); err != nil {{ return nil, err }}
    return result, nil
}}
"""
            declarations.append(body)
    source = (
        "// Code generated by scripts/generate-go-adapters. DO NOT EDIT.\n"
        "package main\n\nimport (\n"
    )
    for package, alias in sorted(imports.items()):
        source += f'    {alias + " " if alias else ""}"{package}"\n'
    source += ")\n\n"
    arguments = ", ".join(f"{name} *{backend}" for backend, name in backends.items())
    registration_source = "\n    ".join(registrations)
    source += f"""func providerServer({arguments}) (*invariant.Server, error) {{
    server, err := invariant.ServerFromBytes(descriptorBytes)
    if err != nil {{ return nil, err }}
    {registration_source}
    return server, nil
}}
\n"""
    source += "\n".join(declarations)
    service_names = [
        f"{file.package}.{service.name}.{method.name}"
        for file, service in services
        for method in service.method
    ]
    file_names = sorted({file.name for file, _ in services})
    file_symbols = [
        "pb.File_" + re.sub(r"[^A-Za-z0-9]", "_", name) for name in file_names
    ]
    test = """// Code generated by scripts/generate-go-adapters. DO NOT EDIT.
package main
import (
    "encoding/json"
    "testing"
    "google.golang.org/protobuf/proto"
    "google.golang.org/protobuf/reflect/protodesc"
    "google.golang.org/protobuf/reflect/protoreflect"
    "google.golang.org/protobuf/types/descriptorpb"
    "google.golang.org/protobuf/types/known/structpb"
"""
    test += f'    pb "{go_package(services[0][0])}"\n)\n'
    test += "func TestCanonicalGeneratedRegistration(t *testing.T) {\n"
    test += (
        "    server, err := providerServer("
        + ", ".join(f"&{backend}{{}}" for backend in backends)
        + ")\n"
    )
    test += """    if err != nil { t.Fatal(err) }
    tools := server.Tools()
    expected := []string{
"""
    test += "\n".join(f'        "{name}",' for name in service_names)
    test += """
    }
    if len(tools) != len(expected) {
        t.Fatalf("tool count = %d, expected %d", len(tools), len(expected))
    }
    for _, name := range expected {
        if tools[name] == nil { t.Fatalf("canonical method absent: %s", name) }
    }
}
func TestGeneratedDescriptorAgreement(t *testing.T) {
    var embedded descriptorpb.FileDescriptorSet
    if err := proto.Unmarshal(descriptorBytes, &embedded); err != nil { t.Fatal(err) }
    generated := []protoreflect.FileDescriptor{
"""
    test += "\n".join(f"        {name}," for name in file_symbols)
    test += """
    }
    for _, descriptor := range generated {
        wanted := protodesc.ToFileDescriptorProto(descriptor)
        found := false
        for _, file := range embedded.File {
            if file.GetName() != wanted.GetName() { continue }
            file.SourceCodeInfo = nil
            if !proto.Equal(file, wanted) {
                t.Fatalf("descriptor graph differs for %s", file.GetName())
            }
            found = true
        }
        if !found {
            t.Fatalf("generated file absent from descriptor: %s", wanted.GetName())
        }
    }
}
func TestExactIntegerBoundary(t *testing.T) {
    if requestInteger(structpb.NewStringValue("9007199254740993")) != 9007199254740993 {
        t.Fatal("int64 request precision lost")
    }
    if providerInteger(json.Number("9007199254740993")) != 9007199254740993 {
        t.Fatal("int64 provider precision lost")
    }
}
"""
    return {
        module / "rpc_adapter.gen.go": formatted(source),
        module / "rpc_codec.gen.go": formatted(CODEC),
        module / "rpc_contract.gen_test.go": formatted(test),
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--bindings", action="store_true")
    parser.add_argument("providers", nargs="*")
    args = parser.parse_args()
    modules = (
        [ROOT / name for name in args.providers]
        if args.providers
        else sorted(path.parent for path in ROOT.glob("*/go.mod"))
    )
    for module in modules:
        if args.bindings:
            bindings(module, args.check)
        for path, body in generate(module).items():
            if args.check:
                if not path.is_file() or path.read_bytes() != body:
                    raise SystemExit(f"stale Go adapter: {path.relative_to(ROOT)}")
            else:
                path.write_bytes(body)


if __name__ == "__main__":
    main()
